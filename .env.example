# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versionar o arquivo .env com segredos reais.

# Segurança
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Para o Render: https://seu-servico.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados PostgreSQL. Use uma credencial restrita para a aplicação.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
# Opcional: credencial administrativa para manutenção explícita.
# Não é usada automaticamente pela aplicação nem pelos testes.
# DATABASE_ADMIN_URL=postgresql://administrador:senha@host/banco?sslmode=require

# Segurança em produção (defina como True apenas atrás de HTTPS)
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
# Ative somente atrás de um proxy HTTPS confiável, como o Render.
DJANGO_TRUST_PROXY_HTTPS=False
DJANGO_HSTS_SECONDS=3600

# Integração com a API do Google Gemini
GEMINI_ENABLED=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
